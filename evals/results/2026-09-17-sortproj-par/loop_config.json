{
  "goal": "Make sorter.process() faster on bench.py's fixed 10000-line input without any test regression",
  "run_tag": "e2e-par",
  "mutable_paths": ["sorter.py"],
  "eval_command": "python3 bench.py > run.log 2>&1",
  "primary": {
    "name": "runtime_ms",
    "extract": "grep '^runtime_ms:' run.log",
    "direction": "min"
  },
  "counter_metrics": [
    {
      "name": "tests_passed",
      "extract": "grep '^tests_passed:' run.log",
      "direction": "max",
      "threshold": 42,
      "comparator": ">="
    }
  ],
  "candidates_per_round": 3,
  "worktree_isolation": true,
  "trial_timeout_seconds": 120,
  "max_rounds": 8,
  "target": null,
  "patience": 3,
  "epsilon": null,
  "epsilon_window": 10,
  "min_delta": 10.0,
  "judge_metric": false,
  "judge_panel_size": 3,
  "judge_prompt_path": null
}
